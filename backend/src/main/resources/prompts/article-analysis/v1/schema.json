{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "article-analysis.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "keyFacts", "entities", "category", "eventType", "confidence"],
  "properties": {
    "summary": { "type": "string", "minLength": 10, "maxLength": 800 },
    "keyFacts": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": { "type": "string", "minLength": 2, "maxLength": 300 }
    },
    "entities": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "type": { "type": "string", "enum": ["PERSON", "ORG", "PLACE", "EVENT", "OTHER"] }
        }
      }
    },
    "category": {
      "type": "string",
      "enum": ["POLITICS", "ECONOMY", "SOCIETY", "WORLD", "TECH", "CULTURE", "SPORTS", "LIFE", "OTHER"]
    },
    "eventType": { "type": "string", "minLength": 1, "maxLength": 100 },
    "multiEvent": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
